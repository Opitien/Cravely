# Copy to .env and fill in from Supabase → Project Settings → API.
# These are PUBLIC values (shipped inside the app). Never put the service-role key
# or the Paystack secret key here — those live only in Supabase function secrets.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
