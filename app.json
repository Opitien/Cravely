{
  "expo": {
    "name": "Cravely",
    "slug": "Cravely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "cravely",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-image",
      "expo-font"
    ],
    "description": "Your cravings, delivered. A fast, modern food delivery experience.",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#131929"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cravely.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131929",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cravely.app",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    }
  }
}
