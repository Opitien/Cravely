{
  "expo": {
    "name": "Cravely",
    "slug": "Cravely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "food-app",
    "plugins": [
      "expo-router"
    ],
    "description": "Your cravings, delivered. A fast, modern food delivery experience.",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#131929"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cravely.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131929",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cravely.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    }
  }
}